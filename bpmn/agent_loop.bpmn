<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0"
                  id="Definitions_agent_loop"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="zenbpm-go"
                  exporterVersion="1.0">
  <bpmn:process id="agent_loop" name="Agent Chat Loop" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_Start_Reply</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Reply" sourceRef="StartEvent_1" targetRef="Task_Reply" />

    <bpmn:serviceTask id="Task_Decide" name="Decide">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="agent-decide" retries="3" retryBackoff="PT10S" />
        <zenbpm:taskHeaders>
          <zenbpm:header key="system_prompt" value="You are a helpful chat assistant. Reply concisely." />
        </zenbpm:taskHeaders>
        <zenbpm:ioMapping>
          <zenbpm:output source="=assistant_text" target="assistant_text" />
          <zenbpm:output source="=context" target="context" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reply_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Decide_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Decide_Gateway" sourceRef="Task_Decide" targetRef="Gateway_Route" />

    <bpmn:exclusiveGateway id="Gateway_Route" name="Route" default="Flow_Reply">
      <bpmn:incoming>Flow_Decide_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Reply</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Reply" name="reply" sourceRef="Gateway_Route" targetRef="Task_Reply" />

    <bpmn:userTask id="Task_Reply" name="Reply">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="agent-reply" retries="3" retryBackoff="PT10S" />
        <zenbpm:ioMapping>
          <zenbpm:output source="=user_message" target="user_message" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reply</bpmn:incoming>
      <bpmn:incoming>Flow_Start_Reply</bpmn:incoming>
      <bpmn:outgoing>Flow_Reply_Decide</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Reply_Decide" sourceRef="Task_Reply" targetRef="Task_Decide" />

    <bpmn:sequenceFlow id="Flow_Fail" name="fail" sourceRef="Gateway_Route" targetRef="Task_FailReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=route = "fail"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_FailReport" name="Fail Report">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="agent-fail-report" retries="3" retryBackoff="PT10S" />
        <zenbpm:taskHeaders>
          <zenbpm:header key="pass_error_message_to_context" value="true" />
        </zenbpm:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
    </bpmn:serviceTask>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="agent_loop">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="100" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Decide_di" bpmnElement="Task_Decide">
        <dc:Bounds x="180" y="98" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Route_di" bpmnElement="Gateway_Route" isMarkerVisible="true">
        <dc:Bounds x="360" y="113" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reply_di" bpmnElement="Task_Reply">
        <dc:Bounds x="470" y="98" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FailReport_di" bpmnElement="Task_FailReport">
        <dc:Bounds x="335" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Reply_di" bpmnElement="Flow_Start_Reply">
        <di:waypoint x="136" y="138" />
        <di:waypoint x="180" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Decide_Gateway_di" bpmnElement="Flow_Decide_Gateway">
        <di:waypoint x="300" y="138" />
        <di:waypoint x="360" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reply_di" bpmnElement="Flow_Reply">
        <di:waypoint x="410" y="138" />
        <di:waypoint x="470" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reply_Decide_di" bpmnElement="Flow_Reply_Decide">
        <di:waypoint x="530" y="98" />
        <di:waypoint x="530" y="60" />
        <di:waypoint x="240" y="60" />
        <di:waypoint x="240" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fail_di" bpmnElement="Flow_Fail">
        <di:waypoint x="385" y="163" />
        <di:waypoint x="385" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
